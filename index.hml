<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Redirecting...</title>
<!-- Twitter Card meta tags -->
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@example_handle">
